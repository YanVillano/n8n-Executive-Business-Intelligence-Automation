      "name": "Sales KPI"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet totalSpend = 0;\nlet totalLeads = 0;\n\nfor (const item of rows) {\n  totalSpend += Number(item.json['Ad Spend']);\n  totalLeads += Number(item.json.Leads);\n}\n\nreturn [{\n  json: {\n    department: \"Marketing\",\n    totalSpend,\n    totalLeads,\n    costPerLead: totalSpend / totalLeads\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
