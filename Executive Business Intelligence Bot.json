    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet totalRevenue = 0;\nlet totalOrders = 0;\n\nfor (const item of rows) {\n  totalRevenue += Number(item.json.Revenue);\n  totalOrders += Number(item.json.Orders);\n}\n\nreturn [{\n  json: {\n    department: \"Sales\",\n    totalRevenue,\n    totalOrders,\n    avgOrderValue: totalRevenue / totalOrders\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
