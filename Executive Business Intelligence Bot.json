        -80
      ],
      "id": "e4fd0b1c-e690-4c7f-8696-b148c8e084a2",
      "name": "Marketing KPI"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet totalTickets = 0;\nlet totalResolved = 0;\nlet totalResponseTime = 0;\n\nfor (const item of rows) {\n  totalTickets += Number(item.json.Tickets);\n  totalResolved += Number(item.json.Resolved);\n  totalResponseTime += Number(item.json['Average Response Time (Minutes)']);\n}\n\nreturn [{\n  json: {\n    department: \"Support\",\n    totalTickets,\n    resolutionRate: totalResolved / totalTickets,\n    avgResponseTime: totalResponseTime / rows.length\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
