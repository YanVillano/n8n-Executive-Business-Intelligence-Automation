      ],
      "id": "cb9cd03d-3e90-43a3-ae78-c77721427bd0",
      "name": "Support KPI"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet totalExpenses = 0;\nlet totalProfit = 0;\n\nfor (const item of rows) {\n  totalExpenses += Number(item.json.Expenses);\n  totalProfit += Number(item.json.Profit);\n}\n\nreturn [{\n  json: {\n    department: \"Finance\",\n    totalExpenses,\n    totalProfit,\n    profitMargin: totalProfit / (totalProfit + totalExpenses)\n  }\n}];\n"
      },
